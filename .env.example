APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional (confirmacion de cuenta, recuperacion de contrasena).
# Sin un servidor valido el registro crea la cuenta pero el correo no sale.
# Para probar en local: MAIL_MAILER=log deja el mensaje en storage/logs.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REDIRECT_TO=
MAIL_REDIRECT_NAME="Pruebas VET-SDI"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CONTABILIDAD_API_URL=http://contabilidad-api.test/api/v1
CONTABILIDAD_API_TOKEN=
CONTABILIDAD_CLIENTE_UUID=
CONTABILIDAD_CONNECT_TIMEOUT=3
CONTABILIDAD_TIMEOUT=10
FARMACIA_CENTRAL_URL=http://farmacia-central-api.test:8080

# Opcionales: URL completa de consulta de beneficios; si se omiten se usa la tienda SSO.
ALIMENTOS_BENEFICIOS_API_URL=
VETERFARMA_BENEFICIOS_API_URL=

# Produccion: configurar URLs HTTPS reales y una clave privada compartida con las tiendas.
SDI_SSO_KEY=
ALIMENTOS_SSO_URL=
VETERFARMA_URL=
SDI_HUB_ENABLED=false
SDI_HUB_URL=
SDI_HUB_KEY=
SDI_HUB_APP=vet-sdi-v13

# Recuperacion por celular: log no envia mensajes. Elegir api o twilio al habilitarlo.
MENSAJERIA_DRIVER=log
MENSAJERIA_COUNTRY_CODE=56
MENSAJERIA_API_URL=
MENSAJERIA_API_TOKEN=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SESSION_SECURE_COOKIE=false
