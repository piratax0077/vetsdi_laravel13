APP_NAME=VET-SDI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
APP_PORT=8082

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vetsdi
DB_USERNAME=vetsdi
DB_PASSWORD=vetsdi_secret
DB_ROOT_PASSWORD=root_secret
FORWARD_DB_PORT=3308

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notificaciones@vetsdi.local"
MAIL_FROM_NAME="${APP_NAME}"

HOST_UID=1000
HOST_GID=1000
